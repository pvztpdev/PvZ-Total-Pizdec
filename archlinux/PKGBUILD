# Maintainer: wszqkzqk <wszqkzqk@qq.com>

pkgname=pvz-total-pizdec
pkgver=0.0.0
pkgrel=1
pkgdesc="A cross-platform community-driven reimplementation of Plants vs. Zombies: Game of the Year Edition, aiming to bring the 100% authentic PvZ experience to every platform."
url="https://github.com/pvztpdev/${pkgname}"
arch=('x86_64' 'aarch64' 'riscv64' 'loong64')
license=('LGPL-3.0-or-later')
depends=(
    glibc
    libgcc
    libjpeg-turbo
    libopenmpt
    libpng
    libstdc++
    sdl3
    sdl3_mixer
    zlib
)
makedepends=(
    cmake
    git
    ninja
)
source=(
    "${pkgname}::git+file://${startdir}/.."
    # IMPORTANT: You must create this file yourself using assets from your legally owned copy.
    # See archlinux/README.md for instructions.
    "Plants_vs._Zombies_1.2.0.1073_EN.zip"
    "pvz-total-pizdec.sh"
    "io.github.pvztpdev.pvz-total-pizdec.desktop"
)
sha256sums=('SKIP'
            'SKIP'
            '3793a8b4ceac2d7dd1f0a30882d4510274ab5209fb2f736e04544c8793f9118a'
            'c06a50aedf4698d7ad1368bc69fbcdbf2f00925688353bbf4b3ef4c288d5f36b')

pkgver() {
    cd "${pkgname}"
    git describe --tags --abbrev=12 | sed 's/^v//;s/-/./g'
}

build() {
    cmake -G Ninja -B build -S "${pkgname}" \
        -DCMAKE_BUILD_TYPE='Release' \
        -DCMAKE_INSTALL_PREFIX='/usr'
    cmake --build build
}

package() {
    mkdir -p "${pkgdir}/usr/share/pvz-total-pizdec"
    install -Dm644 "main.pak" "${pkgdir}/usr/share/pvz-total-pizdec/main.pak"
    cp -r "properties" "${pkgdir}/usr/share/pvz-total-pizdec"

    install -Dm755 "build/pvz-portable" "${pkgdir}/usr/share/pvz-total-pizdec/pvz-total-pizdec"
    install -Dm755 "pvz-portable.sh" "${pkgdir}/usr/bin/pvz-total-pizdec"

    install -Dm644 "${pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "${pkgname}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
    install -Dm644 "io.github.pvztpdev.pvz-total-pizdec.desktop" "${pkgdir}/usr/share/applications/io.github.pvztpdev.pvz-total-pizdec.desktop"
    install -Dm644 "${pkgname}/icon.png" "${pkgdir}/usr/share/pixmaps/io.github.pvztpdev.pvz-total-pizdec.png"
}
